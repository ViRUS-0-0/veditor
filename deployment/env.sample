# Copy to deployment/.env and replace every example secret before starting.
POSTGRES_USER=veditor
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=veditor

SESSION_SECRET=replace-with-at-least-32-random-bytes
ENVIRONMENT=production
BASE_URL=https://veditor.example.org

# Optional email delivery settings.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=True
# SMTP_SSL=False
# SMTP_FROM=VEditor <noreply@example.org>

# Compose settings.
TAG=latest
API_PORT=8000
