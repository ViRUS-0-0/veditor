{% extends "base.html.jinja" %}

{% block title %}Password Reset Failed - VEditor{% endblock %}

{% block breadcrumb %}
  <a href="/login">Sign In</a>
  <span class="sep">/</span>
  <span class="current">Reset Failed</span>
{% endblock %}

{% block extra_head %}
<link rel="stylesheet" href="/static/css/auth.css">
{% endblock %}

{% block content %}
<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <h1 class="auth-title">Password Reset Failed</h1>
      <p class="auth-subtitle">We could not reset your password</p>
    </div>

    <div class="alert alert-danger" role="alert">
      <span>{{ error or "The password reset link is invalid, expired, or has already been used." }}</span>
    </div>

    <div class="auth-info-box">
      <p>Password reset links are valid for {{ expire_hours }} hour{{ 's' if expire_hours != 1 else '' }} and can only be used once. You can request a fresh link to recover your account.</p>
    </div>

    <div class="auth-action-row">
      <a href="/forgot-password" class="btn btn-primary btn-auth-submit">Request New Link</a>
      <a href="/login" class="btn btn-secondary btn-auth-submit">Back to Sign In</a>
    </div>

    <div class="auth-footer">
      <span>Remember your password? <a href="/login">Sign in</a></span>
    </div>
  </div>
</div>
{% endblock %}
