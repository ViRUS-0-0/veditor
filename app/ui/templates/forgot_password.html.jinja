{% extends "base.html.jinja" %}

{% block title %}Forgot Password{% endblock %}

{% block breadcrumb %}
  <a href="/login">Sign In</a>
  <span class="sep">/</span>
  <span class="current">Forgot Password</span>
{% endblock %}

{% block extra_head %}
<link rel="stylesheet" href="/static/css/auth.css">
{% endblock %}

{% block content %}
<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <h1 class="auth-title">Reset Password</h1>
      <p class="auth-subtitle">Enter your email address to receive password reset instructions</p>
    </div>

    {% if error %}
      <div class="alert alert-danger" role="alert">
        <span>{{ error }}</span>
      </div>
    {% endif %}

    {% if message %}
      <div class="auth-info-box">
        <p class="auth-info-text">{{ message }}</p>
        <span class="auth-email-badge">{{ email }}</span>
        <p class="auth-info-hint">Check your spam or junk folder if you don't receive an email within a few minutes.</p>
      </div>
      <div class="auth-action-row">
        <a href="/login" class="btn btn-secondary btn-lg btn-auth-submit">Return to Sign In</a>
      </div>
    {% else %}
      <form class="auth-form" method="post" action="/forgot-password">
        <div class="form-group">
          <label class="form-label" for="email">Email</label>
          <input type="email" id="email" name="email" class="input-field" required autofocus value="{{ email or '' }}" placeholder="name@example.com">
        </div>

        <button type="submit" class="btn btn-primary btn-lg btn-auth-submit">Send Reset Link</button>
      </form>

      <div class="auth-footer">
        <span>Remember your password? <a href="/login">Sign in</a></span>
      </div>
    {% endif %}
  </div>
</div>
{% endblock %}
