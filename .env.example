# Example Environment Variables
# Copy this file to .env and adjust values for your local environment.

# Database Configuration
POSTGRES_USER=veditor
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=veditor

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Storage Configuration
# DATA_DIR: The local directory where files will be stored when STORAGE_BACKEND is 'local'
DATA_DIR=data
# STORAGE_BACKEND: The storage backend to use. Must be either 'local' or 's3'
STORAGE_BACKEND=local

# Optional Settings
# SECRET_KEY=your_super_secret_key
# DEBUG=True

# S3 Configuration (Deferred)
# S3_BUCKET: The name of the S3 bucket or MinIO bucket to store files in.
# S3_BUCKET=my-bucket
# S3_REGION: The AWS region where the bucket is located (e.g., us-east-1).
# S3_REGION=us-east-1
# S3_ENDPOINT_URL: Required for MinIO compatibility to point to the self-hosted instance.
# S3_ENDPOINT_URL=http://localhost:9000
